{
  "name": "dsh-clock",
  "version": "1.7.0",
  "description": "Move45clock · 健康钟：每工作 45 分钟弹出引导式休息卡片，内置 22 套计划（12 套运动 + 4 套家务休闲 + 6 套 3～5 分钟短运动）；支持「你偏爱的计划类」（纯运动 / 运动+家务 / 短短短长）、删除/恢复计划、可视化编辑、弹窗放大、今日统计与连续天数、到点置顶小窗、夜间提醒和可选的动作名语音播报。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "health",
    "break",
    "timer",
    "pomodoro",
    "move45clock",
    "健康钟",
    "休息"
  ],
  "author": "A first-time vibecoder",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "install:plugin": "node tools/install.js",
    "status": "node tools/install.js --status",
    "uninstall:plugin": "node tools/install.js --uninstall",
    "test:clock": "node tools/test-clock.mjs",
    "test:host": "node tools/test-host.mjs",
    "test:night": "node tools/test-night.mjs",
    "test:plans": "node tools/test-plans.mjs",
    "test:stats": "node tools/test-stats.mjs",
    "test:resume": "node tools/test-resume.mjs",
    "test:client-css": "node tools/test-client-css.mjs",
    "test": "node tools/test-plans.mjs && node tools/test-clock.mjs && node tools/test-night.mjs && node tools/test-stats.mjs && node tools/test-resume.mjs && node tools/test-host.mjs && node tools/test-client-css.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "license": "MIT"
}

{
  "name": "dsh-move45clock",
  "version": "1.4.0",
  "description": "Move45clock · 健康钟：每工作 45 分钟弹出引导式休息卡片，内置 12 套 12～15 分钟坐/站计划；支持可视化编辑计划、弹窗放大、夜间提醒和可选的动作名语音播报。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "health",
    "break",
    "timer",
    "pomodoro",
    "move45clock",
    "健康钟",
    "休息"
  ],
  "author": "A first-time vibecoder",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "install:plugin": "node tools/install.js",
    "status": "node tools/install.js --status",
    "uninstall:plugin": "node tools/install.js --uninstall",
    "test:clock": "node tools/test-clock.mjs",
    "test:host": "node tools/test-host.mjs",
    "test:night": "node tools/test-night.mjs",
    "test:plans": "node tools/test-plans.mjs",
    "test": "node tools/test-plans.mjs && node tools/test-clock.mjs && node tools/test-night.mjs && node tools/test-host.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "license": "MIT"
}

# 默认：文本文件交给 git 按平台自动处理换行
* text=auto

# 代码与文档：统一 LF（DSH/Node 读 LF 没问题，跨机协作不打架）
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# Windows 批处理：必须 CRLF（cmd.exe 按 OEM 读批处理，LF 可能出怪问题）
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
